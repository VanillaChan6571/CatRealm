# CatRealm Central base URL.
# Defaults to the official CatRealm Central service.
VITE_AUTH_SERVER_URL=https://auth.catrealm.app

# Route HTTP-only realms through the HTTPS gateway at bridge.catrealm.app (live).
# VITE_HTTP_REALM_GATEWAY_ENABLED=true

# Optional: public client origin used for invite/share flows when building outside
# the official catrealm.app deployment.
# VITE_CLIENT_URL=https://catrealm.app

# Optional: override the hosted hCaptcha site key used by central registration.
# Leave unset to use the default runtime configuration.
# VITE_HCAPTCHA_SITEKEY=

# Optional: CatRealm Radio stream URL. Defaults to <VITE_AUTH_SERVER_URL>/radio/CatRealmCozyVibes.mp3,
# which Central serves from landing/radio/ (see Agents-Docs/HANDOFF-Central-CatRealm-Radio.md).
# VITE_RADIO_TRACK_URL=https://auth.catrealm.app/radio/CatRealmCozyVibes.mp3
