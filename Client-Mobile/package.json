{
  "name": "catrealm-client-mobile",
  "version": "1.9.1-mobile",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Official CatRealm mobile client (iOS + Android, Expo + React Native).",
  "main": "expo-router/entry",
  "scripts": {
    "start": "CI=1 expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --watch",
    "test:ci": "jest --ci",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "postinstall": "patch-package --error-on-fail"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@expo/metro-runtime": "~58.0.14",
    "@livekit/react-native": "3.0.0",
    "@livekit/react-native-expo-plugin": "^1.0.3",
    "@livekit/react-native-webrtc": "144.2.0",
    "@noble/curves": "^2.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@stablelib/aes": "^2.0.1",
    "@stablelib/gcm": "^2.0.1",
    "@stablelib/hmac": "^2.0.1",
    "@stablelib/pbkdf2": "^2.0.1",
    "@stablelib/sha256": "^2.0.1",
    "axios": "^1.7.7",
    "babel-plugin-module-resolver": "^5.0.3",
    "eld": "^2.1.0",
    "emojibase": "^17.0.0",
    "emojibase-data": "^17.0.0",
    "expo": "~58.0.16",
    "expo-asset": "~58.0.14",
    "expo-audio": "~58.0.9",
    "expo-battery": "~58.0.3",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.11",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-media-library": "~58.0.11",
    "expo-notification-service-extension-plugin": "^1.0.2",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.24",
    "expo-screen-orientation": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.19",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-video": "~58.0.12",
    "i18next": "^26.2.0",
    "livekit-client": "^2.19.0",
    "lucide-react-native": "^1.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-svg-transformer": "^1.5.3",
    "react-native-web": "^0.21.4",
    "react-native-web-webview": "^1.0.2",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "react-native-youtube-iframe": "^2.3.0",
    "socket.io-client": "^4.8.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.0-rc.4",
    "@react-native/metro-config": "0.88.0-rc.4",
    "@testing-library/react-native": "^14.0.1",
    "@types/dom-mediacapture-record": "^1.0.22",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.12.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "file-loader": "^6.2.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.11",
    "metro-runtime": "0.87.1",
    "patch-package": "^8.0.1",
    "prettier": "^3.3.3",
    "test-renderer": "~1.2.0",
    "typescript": "~6.0.3",
    "webpack": "^5.111.1"
  },
  "jest": {
    "preset": "jest-expo",
    "transform": {
      "^.+\\.ogg$": "jest-expo/src/preset/assetFileTransformer.js"
    },
    "moduleNameMapper": {
      "^eld/extrasmall$": "<rootDir>/node_modules/eld/src/entries/static.extrasmall.js"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|eld))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "optionalDependencies": {
    "@expo/config-plugins": "~58.0.8"
  },
  "overrides": {
    "expo-notification-service-extension-plugin": {
      "semver": "^7.5.4"
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "jest",
        "@types/jest"
      ]
    }
  }
}
