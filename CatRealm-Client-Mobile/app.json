{
  "expo": {
    "name": "CatRealm",
    "slug": "catrealm-mobile",
    "version": "1.9.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "catrealm",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#171225",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.nwya.catrealm.mobile",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true,
        "NSCameraUsageDescription": "CatRealm needs camera access for video calls and theater rooms.",
        "NSMicrophoneUsageDescription": "CatRealm needs microphone access for voice and video calls.",
        "NSPhotoLibraryUsageDescription": "CatRealm needs photo access to share images in chat.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "UIBackgroundModes": [
          "remote-notification",
          "voip"
        ],
        "LSSupportsOpeningDocumentsInPlace": false
      }
    },
    "android": {
      "package": "app.catrealm.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-background.png",
        "backgroundColor": "#171225"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WAKE_LOCK",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notification-service-extension-plugin",
        {
          "mode": "development",
          "iosNSEFilePath": "./assets/NotificationService.m"
        }
      ],
      "./plugins/withCommunicationNotifications",
      "expo-router",
      "expo-dev-client",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "expo-secure-store",
      "expo-font",
      ["expo-video", { "supportsBackgroundPlayback": true, "supportsPictureInPicture": true }],
      "expo-audio",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7c3aed",
          "androidMode": "default",
          "iosDisplayInForeground": true
        }
      ],
      "expo-asset",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#171225"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          },
          "android": {
            "usesCleartextTraffic": true,
            "extraProguardRules": "-keep class livekit.org.jni_zero.** { *; }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/devmobile"
    },
    "extra": {
      "authServerUrl": "https://auth.catrealm.app",
      "defaultServerUrl": {},
      "router": {},
      "eas": {
        "projectId": "3eced1a7-2d18-4052-a831-e6aae94086b3"
      }
    }
  }
}
